{"ast":null,"code":"export default {\n  name: 'DevUIImage',\n  props: {\n    src: {\n      type: String,\n      default: 'https://via.placeholder.com/150'\n    },\n    styleConfig: {\n      type: Object,\n      default: () => ({})\n    },\n    componentId: {\n      type: String,\n      default: ''\n    }\n  },\n  computed: {\n    mergedStyle() {\n      return {\n        width: '150px',\n        height: '150px',\n        objectFit: 'cover',\n        ...this.styleConfig\n      };\n    }\n  },\n  methods: {\n    handleClick() {\n      this.$emit('component-click', this.componentId);\n    }\n  }\n};","map":{"version":3,"names":["name","props","src","type","String","default","styleConfig","Object","componentId","computed","mergedStyle","width","height","objectFit","methods","handleClick","$emit"],"sources":["src/components-ui/basic/DevUIImage.vue"],"sourcesContent":["<template>\n  <div class=\"dev-ui-image\" @click.stop=\"handleClick\">\n    <img class=\"ui-image\" :src=\"src\" :style=\"mergedStyle\" />\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'DevUIImage',\n  props: {\n    src: {\n      type: String,\n      default: 'https://via.placeholder.com/150'\n    },\n    styleConfig: {\n      type: Object,\n      default: () => ({})\n    },\n    componentId: {\n      type: String,\n      default: ''\n    }\n  },\n  computed: {\n    mergedStyle() {\n      return {\n        width: '150px',\n        height: '150px',\n        objectFit: 'cover',\n        ...this.styleConfig\n      }\n    }\n  },\n  methods: {\n    handleClick() {\n      this.$emit('component-click', this.componentId)\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.dev-ui-image {\n  display: inline-block;\n  transition: all 0.3s ease;\n  \n  &:hover {\n    outline: 2px solid #2d8cf0;\n    outline-offset: 2px;\n  }\n  \n  .ui-image {\n    display: block;\n  }\n}\n</style>\n"],"mappings":"AAOA;EACAA,IAAA;EACAC,KAAA;IACAC,GAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACAC,WAAA;MACAH,IAAA,E