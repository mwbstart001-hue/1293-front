{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'PropsEditor',\n  props: {\n    config: {\n      type: Object,\n      required: true\n    }\n  },\n  data() {\n    return {\n      localProps: {}\n    };\n  },\n  computed: {\n    componentProps() {\n      const props = {\n        ...this.config.props\n      };\n      delete props.style;\n      return props;\n    }\n  },\n  watch: {\n    config: {\n      handler(val) {\n        this.localProps = {\n          ...val.props\n        };\n      },\n      immediate: true,\n      deep: true\n    }\n  },\n  methods: {\n    getLabel(key) {\n      const labelMap = {\n        type: '类型',\n        size: '尺寸',\n        text: '文本',\n        placeholder: '占位符',\n        clearable: '可清空',\n        label: '标签',\n        content: '内容',\n        src: '图片地址',\n        dashed: '虚线',\n        title: '标题',\n        gutter: '间距',\n        columns: '列配置',\n        data: '数据'\n      };\n      return labelMap[key] || key;\n    },\n    isStyleKey(key) {\n      return key === 'style' || key === 'styleConfig';\n    },\n    handleChange(key) {\n      this.$emit('update', key, this.localProps[key]);\n    },\n    addArrayItem(key) {\n      if (!this.localProps[key]) {\n        this.localProps[key] = [];\n      }\n      this.localProps[key].push('');\n      this.handleChange(key);\n    },\n    removeArrayItem(key, index) {\n      this.localProps[key].splice(index, 1);\n      this.handleChange(key);\n    }\n  }\n};","map":{"version":3,"names":["name","props","config","type","Object","required","data","localProps","computed","componentProps","style","watch","handler","val","immediate","deep","methods","getLabel","key","labelMap","size","text","placeholder","clearable","label","content","src","dashed","title","gutter","columns","isStyleKey","handleChange","$emit","addArrayItem","push","removeArrayItem","index","splice"],"sources":["src/components/studio/editors/PropsEditor.vue"],"sourcesContent":["<template>\n  <div class=\"props-editor\">\n    <Form :label-width=\"80\" label-position=\"left\" size=\"small\">\n      <template v-for=\"(value, key) in componentProps\">\n        <FormItem :key=\"key\" :label=\"getLabel(key)\">\n          <template v-if=\"isStyleKey(key)\">\n            <span class=\"style-hint\">请在样式配置中设置</span>\n          </template>\n          \n          <template v-else-if=\"typeof value === 'string'\">\n            <Input\n              v-model=\"localProps[key]\"\n              :placeholder=\"'请输入' + getLabel(key)\"\n              @on-change=\"handleChange(key)\"\n            />\n          </template>\n          \n          <template v-else-if=\"typeof value === 'number'\">\n            <InputNumber\n              v-model=\"localProps[key]\"\n              style=\"width: 100%\"\n              @on-change=\"handleChange(key)\"\n            />\n          </template>\n          \n          <template v-else-if=\"typeof value === 'boolean'\">\n            <Switch v-model=\"localProps[key]\" @on-change=\"handleChange(key)\" />\n          </template>\n          \n          <template v-else-if=\"Array.isArray(value)\">\n            <div class=\"array-editor\">\n              <div v-for=\"(item, index) in localProps[key]\" :key=\"index\" class=\"array-item\">\n                <Input v-model=\"localProps[key][index]\" size=\"small\" />\n                <Button size=\"small\" type=\"text\" @click=\"removeArrayItem(key, index)\">\n                  <Icon type=\"md-close\" />\n                </Button>\n              </div>\n              <Button size=\"small\" type=\"dashed\" long @click=\"addArrayItem(key)\">\n                <Icon type=\"md-add\" /> 添加\n              </Button>\n            </div>\n          </template>\n          \n          <template v-else>\n            <Input\n              v-model=\"localProps[key]\"\n              type=\"textarea\"\n              :rows=\"3\"\n              @on-change=\"handleChange(key)\"\n            />\n          </template>\n        </FormItem>\n      </template>\n    </Form>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'PropsEditor',\n  props: {\n    config: {\n      type: Object,\n      required: true\n    }\n  },\n  data() {\n    return {\n      localProps: {}\n    }\n  },\n  computed: {\n    componentProps() {\n      const props = { ...this.config.props }\n      delete props.style\n      return props\n    }\n  },\n  watch: {\n    config: {\n      handler(val) {\n        this.localProps = { ...val.props }\n      },\n      immediate: true,\n      deep: true\n    }\n  },\n  methods: {\n    getLabel(key) {\n      const labelMap = {\n        type: '类型',\n        size: '尺寸',\n        text: '文本',\n        placeholder: '占位符',\n        clearable: '可清空',\n        label: '标签',\n        content: '内容',\n        src: '图片地址',\n        dashed: '虚线',\n        title: '标题',\n        gutter: '间距',\n        columns: '列配置',\n        data: '数据'\n      }\n      return labelMap[key] || key\n    },\n    isStyleKey(key) {\n      return key === 'style' || key === 'styleConfig'\n    },\n    handleChange(key) {\n      this.$emit('update', key, this.localProps[key])\n    },\n    addArrayItem(key) {\n      if (!this.localProps[key]) {\n        this.localProps[key] = []\n      }\n      this.localProps[key].push('')\n      this.handleChange(key)\n    },\n    removeArrayItem(key, index) {\n      this.localProps[key].splice(index, 1)\n      this.handleChange(key)\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.props-editor {\n  padding: 16px;\n  \n  :deep(.ivu-form-item) {\n    margin-bottom: 16px;\n  }\n  \n  .style-hint {\n    color: #808695;\n    font-size: 12px;\n  }\n  \n  .array-editor {\n    .array-item {\n      display: flex;\n      gap: 4px;\n      margin-bottom: 8px;\n    }\n  }\n}\n</style>\n"],"mappings":";AA0DA;EACAA,IAAA;EACAC,KAAA;IACAC,MAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,QAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACAC,eAAA;MACA,MAAAR,KAAA;QAAA,QAAAC,MAA