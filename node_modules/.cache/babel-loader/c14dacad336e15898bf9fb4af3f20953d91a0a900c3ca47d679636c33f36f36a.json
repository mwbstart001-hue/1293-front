{"ast":null,"code":"export default {\n  name: 'DevUIRow',\n  props: {\n    gutter: {\n      type: Number,\n      default: 16\n    },\n    componentId: {\n      type: String,\n      default: ''\n    }\n  },\n  computed: {\n    isEmpty() {\n      return !this.$slots.default || this.$slots.default.length === 0;\n    }\n  },\n  methods: {\n    handleClick() {\n      this.$emit('component-click', this.componentId);\n    }\n  }\n};","map":{"version":3,"names":["name","props","gutter","type","Number","default","componentId","String","computed","isEmpty","$slots","length","methods","handleClick","$emit"],"sources":["src/components-ui/container/DevUIRow.vue"],"sourcesContent":["<template>\n  <Row class=\"dev-ui-row\" :gutter=\"gutter\" @click.native.stop=\"handleClick\">\n    <slot></slot>\n    <div v-if=\"isEmpty\" class=\"empty-placeholder\">\n      <Icon type=\"ios-add-circle-outline\" size=\"20\" />\n      <span>拖拽组件到此处</span>\n    </div>\n  </Row>\n</template>\n\n<script>\nexport default {\n  name: 'DevUIRow',\n  props: {\n    gutter: {\n      type: Number,\n      default: 16\n    },\n    componentId: {\n      type: String,\n      default: ''\n    }\n  },\n  computed: {\n    isEmpty() {\n      return !this.$slots.default || this.$slots.default.length === 0\n    }\n  },\n  methods: {\n    handleClick() {\n      this.$emit('component-click', this.componentId)\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.dev-ui-row {\n  min-height: 50px;\n  transition: all 0.3s ease;\n  \n  &:hover {\n    outline: 2px solid #2d8cf0;\n    outline-offset: -2px;\n  }\n  \n  .empty-placeholder {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    min-height: 50px;\n    width: 100%;\n    color: #c5c8ce;\n    border: 1px dashed #dcdee2;\n    border-radius: 4px;\n    \n    span {\n      margin-top: 6px;\n      font-size: 12px;\n    }\n  }\n}\n</style>\n"],"mappings":"AAWA;EACAA,IAAA;EACAC,KAAA;IACAC,MAAA;MACAC,IAAA,EAAAC,MAA