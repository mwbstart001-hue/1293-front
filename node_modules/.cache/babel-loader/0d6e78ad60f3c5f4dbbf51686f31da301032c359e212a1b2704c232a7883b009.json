{"ast":null,"code":"import \"core-js/modules/es.json.stringify.js\";\nimport PreviewCanvas from './PreviewCanvas.vue';\nexport default {\n  name: 'EditorHeader',\n  components: {\n    PreviewCanvas\n  },\n  props: {\n    mode: {\n      type: String,\n      default: 'edit'\n    },\n    canUndo: {\n      type: Boolean,\n      default: false\n    },\n    canRedo: {\n      type: Boolean,\n      default: false\n    },\n    componentTree: {\n      type: Array,\n      default: () => []\n    }\n  },\n  data() {\n    return {\n      localMode: this.mode,\n      previewVisible: false,\n      exportVisible: false,\n      exportJson: ''\n    };\n  },\n  watch: {\n    mode(val) {\n      this.localMode = val;\n    }\n  },\n  methods: {\n    handleModeChange(val) {\n      this.$emit('mode-change', val);\n    },\n    handlePreview() {\n      this.previewVisible = true;\n    },\n    handleSave() {\n      this.$emit('save');\n    },\n    handleExport() {\n      this.exportJson = JSON.stringify(this.componentTree, null, 2);\n      this.exportVisible = true;\n    },\n    copyExportJson() {\n      navigator.clipboard.writeText(this.exportJson).then(() => {\n        this.$Message.success('已复制到剪贴板');\n      });\n    }\n  }\n};","map":{"version":3,"names":["PreviewCanvas","name","components","props","mode","type","String","default","canUndo","Boolean","canRedo","componentTree","Array","data","localMode","previewVisible","exportVisible","exportJson","watch","val","methods","handleModeChange","$emit","handlePreview","handleSave","handleExport","JSON","stringify","copyExportJson","navigator","clipboard","writeText","then","$Message","success"],"sources":["src/components/studio/EditorHeader.vue"],"sourcesContent":["<template>\n  <header class=\"editor-header\">\n    <div class=\"header-left\">\n      <div class=\"logo\">\n        <Icon type=\"ios-color-wand-outline\" size=\"24\" />\n        <span>低代码编辑器</span>\n      </div>\n    </div>\n    \n    <div class=\"header-center\">\n      <ButtonGroup>\n        <Button :disabled=\"!canUndo\" @click=\"$emit('undo')\">\n          <Icon type=\"ios-undo\" />\n          撤回\n        </Button>\n        <Button :disabled=\"!canRedo\" @click=\"$emit('redo')\">\n          <Icon type=\"ios-redo\" />\n          前进\n        </Button>\n      </ButtonGroup>\n      \n      <Divider type=\"vertical\" />\n      \n      <RadioGroup v-model=\"localMode\" type=\"button\" @on-change=\"handleModeChange\">\n        <Radio label=\"edit\">\n          <Icon type=\"ios-create-outline\" />\n          编辑模式\n        </Radio>\n        <Radio label=\"preview\">\n          <Icon type=\"ios-eye-outline\" />\n          预览模式\n        </Radio>\n      </RadioGroup>\n    </div>\n    \n    <div class=\"header-right\">\n      <Button @click=\"handlePreview\">\n        <Icon type=\"ios-play-outline\" />\n        预览\n      </Button>\n      <Button type=\"primary\" @click=\"handleSave\">\n        <Icon type=\"ios-save\" />\n        保存\n      </Button>\n      <Button @click=\"handleExport\">\n        <Icon type=\"ios-download-outline\" />\n        导出JSON\n      </Button>\n    </div>\n    \n    <Modal v-model=\"previewVisible\" title=\"预览\" fullscreen footer-hide>\n      <PreviewCanvas :component-tree=\"componentTree\" />\n    </Modal>\n    \n    <Modal v-model=\"exportVisible\" title=\"导出JSON\" width=\"600\">\n      <Input\n        v-model=\"exportJson\"\n        type=\"textarea\"\n        :rows=\"20\"\n        readonly\n      />\n      <template #footer>\n        <Button @click=\"exportVisible = false\">关闭</Button>\n        <Button type=\"primary\" @click=\"copyExportJson\">复制JSON</Button>\n      </template>\n    </Modal>\n  </header>\n</template>\n\n<script>\nimport PreviewCanvas from './PreviewCanvas.vue'\n\nexport default {\n  name: 'EditorHeader',\n  components: {\n    PreviewCanvas\n  },\n  props: {\n    mode: {\n      type: String,\n      default: 'edit'\n    },\n    canUndo: {\n      type: Boolean,\n      default: false\n    },\n    canRedo: {\n      type: Boolean,\n      default: false\n    },\n    componentTree: {\n      type: Array,\n      default: () => []\n    }\n  },\n  data() {\n    return {\n      localMode: this.mode,\n      previewVisible: false,\n      exportVisible: false,\n      exportJson: ''\n    }\n  },\n  watch: {\n    mode(val) {\n      this.localMode = val\n    }\n  },\n  methods: {\n    handleModeChange(val) {\n      this.$emit('mode-change', val)\n    },\n    handlePreview() {\n      this.previewVisible = true\n    },\n    handleSave() {\n      this.$emit('save')\n    },\n    handleExport() {\n      this.exportJson = JSON.stringify(this.componentTree, null, 2)\n      this.exportVisible = true\n    },\n    copyExportJson() {\n      navigator.clipboard.writeText(this.exportJson).then(() => {\n        this.$Message.success('已复制到剪贴板')\n      })\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.editor-header {\n  height: 80px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 24px;\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);\n  \n  .header-left {\n    .logo {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      color: #fff;\n      \n      span {\n        font-size: 18px;\n        font-weight: 600;\n        letter-spacing: 1px;\n      }\n    }\n  }\n  \n  .header-center {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    \n    :deep(.ivu-btn-group) {\n      .ivu-btn {\n        background: rgba(255, 255, 255, 0.15);\n        border-color: rgba(255, 255, 255, 0.3);\n        color: #fff;\n        \n        &:hover:not(:disabled) {\n          background: rgba(255, 255, 255, 0.25);\n        }\n        \n        &:disabled {\n          opacity: 0.5;\n        }\n      }\n    }\n    \n    :deep(.ivu-radio-group-button) {\n      .ivu-radio-wrapper {\n        background: rgba(255, 255, 255, 0.15);\n        border-color: rgba(255, 255, 255, 0.3);\n        color: #fff;\n        \n        &:hover {\n          background: rgba(255, 255, 255, 0.25);\n        }\n        \n        &.ivu-radio-wrapper-checked {\n          background: #fff;\n          color: #667eea;\n        }\n      }\n    }\n    \n    :deep(.ivu-divider-vertical) {\n      background: rgba(255, 255, 255, 0.3);\n    }\n  }\n  \n  .header-right {\n    display: flex;\n    gap: 12px;\n    \n    :deep(.ivu-btn) {\n      background: rgba(255, 255, 255, 0.15);\n      border-color: rgba(255, 255, 255, 0.3);\n      color: #fff;\n      \n      &:hover {\n        background: rgba(255, 255, 255, 0.25);\n      }\n      \n      &.ivu-btn-primary {\n        background: #fff;\n        color: #667eea;\n        border-color: #fff;\n        \n        &:hover {\n          background: #f0f0f0;\n        }\n      }\n    }\n  }\n}\n</style>\n"],"mappings":";AAsEA,OAAAA,aAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;EACAG,KAAA;IACAC,IAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACAC,OAAA;MACAH,IAAA,EAAAI,OAAA;MACAF,OAAA;IACA;IACAG,OAAA;MACAL,IAAA,EAAAI,OAAA;MACAF,OAAA;IACA;IACAI,aAAA;MACAN,IAAA,EAAAO,KAAA;MACAL,OAAA,EAAAA,CAAA;IACA;EACA;EACAM,KAAA;IACA;MACAC,SAAA,OAAAV,IAAA;MACAW,cAAA;MACAC,aAAA;MACAC,UAAA;IACA;EACA;EACAC,KAAA;IACAd,KAAAe,GAAA;MACA,KAAAL,SAAA,GAAAK,GAAA;IACA;EACA;EACAC,OAAA;IACAC,iBAAAF,GAAA;MACA,KAAAG,KAAA,gBAAAH,GAAA;IACA;IACAI,cAAA;MACA,KAAAR,cAAA;IACA;IACAS,WAAA;MACA,KAAAF,KAAA;IACA;IACAG,aAAA;MACA,KAAAR,UAAA,GAAAS,IAAA,CAAAC,SAAA,MAAAhB,aAAA;MACA,KAAAK,aAAA;IACA;IACAY,eAAA;MACAC,SAAA,CAAAC,SAAA,CAAAC,SAAA,MAAAd,UAAA,EAAAe,IAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}