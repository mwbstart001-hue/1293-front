{"ast":null,"code":"export default {\n  name: 'DevUIContainer',\n  props: {\n    styleConfig: {\n      type: Object,\n      default: () => ({})\n    },\n    componentId: {\n      type: String,\n      default: ''\n    }\n  },\n  computed: {\n    mergedStyle() {\n      return {\n        ...this.styleConfig\n      };\n    },\n    isEmpty() {\n      return !this.$slots.default || this.$slots.default.length === 0;\n    }\n  },\n  methods: {\n    handleClick() {\n      this.$emit('component-click', this.componentId);\n    }\n  }\n};","map":{"version":3,"names":["name","props","styleConfig","type","Object","default","componentId","String","computed","mergedStyle","isEmpty","$slots","length","methods","handleClick","$emit"],"sources":["src/components-ui/container/DevUIContainer.vue"],"sourcesContent":["<template>\n  <div class=\"dev-ui-container\" :style=\"mergedStyle\" @click.stop=\"handleClick\">\n    <slot></slot>\n    <div v-if=\"isEmpty\" class=\"empty-placeholder\">\n      <Icon type=\"ios-add-circle-outline\" size=\"24\" />\n      <span>拖拽组件到此处</span>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'DevUIContainer',\n  props: {\n    styleConfig: {\n      type: Object,\n      default: () => ({})\n    },\n    componentId: {\n      type: String,\n      default: ''\n    }\n  },\n  computed: {\n    mergedStyle() {\n      return {\n        ...this.styleConfig\n      }\n    },\n    isEmpty() {\n      return !this.$slots.default || this.$slots.default.length === 0\n    }\n  },\n  methods: {\n    handleClick() {\n      this.$emit('component-click', this.componentId)\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.dev-ui-container {\n  position: relative;\n  min-height: 100px;\n  transition: all 0.3s ease;\n  \n  &:hover {\n    outline: 2px solid #2d8cf0;\n    outline-offset: -2px;\n  }\n  \n  .empty-placeholder {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    min-height: 100px;\n    color: #c5c8ce;\n    border: 1px dashed #dcdee2;\n    border-radius: 4px;\n    \n    span {\n      margin-top: 8px;\n      font-size: 12px;\n    }\n  }\n}\n</style>\n"],"mappings":"AAWA;EACAA,IAAA;EACAC,KAAA;IACAC,WAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA,EAAAA,CAAA;IACA;IACAC,WAAA;MACAH,IAAA,EAAAI,MAAA;MACAF,OAAA;IACA;EACA;EACAG,QAAA;IACAC,YAAA;MACA;QACA,QAAAP;MACA;IACA;IACAQ,QAAA;MACA,aAAAC,MAAA,CAAAN,OAAA,SAAAM,MAAA,CAAAN,OAAA,CAAAO,MAAA;IACA;EACA;EACAC,OAAA;IACAC,YAAA;MACA,KAAAC,KAAA,yBAAAT,WAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}