{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.json.stringify.js\";\nimport EditorHeader from './studio/EditorHeader.vue';\nimport StudioComponentMenu from './studio/StudioComponentMenu.vue';\nimport PageCanvas from './studio/PageCanvas.vue';\nimport ConfigPanel from './studio/ConfigPanel.vue';\nexport default {\n  name: 'LowCodeEditor',\n  components: {\n    EditorHeader,\n    StudioComponentMenu,\n    PageCanvas,\n    ConfigPanel\n  },\n  data() {\n    return {\n      editorMode: 'edit',\n      componentTree: [],\n      activeComponentId: '',\n      historyStack: [],\n      historyIndex: -1,\n      maxHistory: 50\n    };\n  },\n  computed: {\n    activeComponent() {\n      if (!this.activeComponentId) return null;\n      return this.$utils.findComponentById(this.componentTree, this.activeComponentId);\n    },\n    canUndo() {\n      return this.historyIndex > 0;\n    },\n    canRedo() {\n      return this.historyIndex < this.historyStack.length - 1;\n    }\n  },\n  created() {\n    this.pushHistory();\n  },\n  methods: {\n    handleModeChange(mode) {\n      this.editorMode = mode;\n    },\n    handleComponentClick(item) {\n      this.activeComponentId = item.componentId;\n    },\n    handleComponentDelete(componentId) {\n      this.$utils.removeComponentById(this.componentTree, componentId);\n      if (this.activeComponentId === componentId) {\n        this.activeComponentId = '';\n      }\n      this.pushHistory();\n    },\n    handleComponentUpdate(updated) {\n      this.$utils.updateComponentById(this.componentTree, updated.componentId, updated);\n      this.pushHistory();\n    },\n    handleCanvasChange(tree) {\n      this.componentTree = [...tree];\n      this.pushHistory();\n    },\n    handleClearCanvas() {\n      this.componentTree = [];\n      this.activeComponentId = '';\n      this.pushHistory();\n    },\n    handleUndo() {\n      if (this.canUndo) {\n        this.historyIndex--;\n        this.componentTree = this.$utils.deepClone(this.historyStack[this.historyIndex]);\n      }\n    },\n    handleRedo() {\n      if (this.canRedo) {\n        this.historyIndex++;\n        this.componentTree = this.$utils.deepClone(this.historyStack[this.historyIndex]);\n      }\n    },\n    pushHistory() {\n      const snapshot = this.$utils.deepClone(this.componentTree);\n      if (this.historyIndex < this.historyStack.length - 1) {\n        this.historyStack = this.historyStack.slice(0, this.historyIndex + 1);\n      }\n      this.historyStack.push(snapshot);\n      if (this.historyStack.length > this.maxHistory) {\n        this.historyStack.shift();\n      } else {\n        this.historyIndex++;\n      }\n    },\n    handleSave() {\n      const json = JSON.stringify(this.componentTree, null, 2);\n      console.log('保存的JSON:', json);\n      localStorage.setItem('low-code-cache', json);\n      this.$Message.success({\n        content: '保存成功！JSON 已输出到控制台',\n        duration: 3\n      });\n    },\n    getCanvasJson() {\n      return this.$utils.deepClone(this.componentTree);\n    }\n  }\n};","map":{"version":3,"names":["EditorHeader","StudioComponentMenu","PageCanvas","ConfigPanel","name","components","data","editorMode","componentTree","activeComponentId","historyStack","historyIndex","maxHistory","computed","activeComponent","$utils","findComponentById","canUndo","canRedo","length","created","pushHistory","methods","handleModeChange","mode","handleComponentClick","item","componentId","handleComponentDelete","removeComponentById","handleComponentUpdate","updated","updateComponentById","handleCanvasChange","tree","handleClearCanvas","handleUndo","deepClone","handleRedo","snapshot","slice","push","shift","handleSave","json","JSON","stringify","console","log","localStorage","setItem","$Message","success","content","duration","getCanvasJson"],"sources":["src/components/LowCodeEditor.vue"],"sourcesContent":["<template>\n  <div class=\"low-code-editor\">\n    <EditorHeader\n      :mode=\"editorMode\"\n      :can-undo=\"canUndo\"\n      :can-redo=\"canRedo\"\n      :component-tree=\"componentTree\"\n      @mode-change=\"handleModeChange\"\n      @undo=\"handleUndo\"\n      @redo=\"handleRedo\"\n      @save=\"handleSave\"\n    />\n    \n    <div class=\"editor-body\">\n      <aside class=\"left-panel\">\n        <StudioComponentMenu />\n      </aside>\n      \n      <main class=\"center-panel\">\n        <PageCanvas\n          :component-tree=\"componentTree\"\n          :active-component-id=\"activeComponentId\"\n          @component-click=\"handleComponentClick\"\n          @component-delete=\"handleComponentDelete\"\n          @canvas-change=\"handleCanvasChange\"\n          @clear-canvas=\"handleClearCanvas\"\n        />\n      </main>\n      \n      <aside class=\"right-panel\">\n        <ConfigPanel\n          :active-component=\"activeComponent\"\n          @update=\"handleComponentUpdate\"\n        />\n      </aside>\n    </div>\n  </div>\n</template>\n\n<script>\nimport EditorHeader from './studio/EditorHeader.vue'\nimport StudioComponentMenu from './studio/StudioComponentMenu.vue'\nimport PageCanvas from './studio/PageCanvas.vue'\nimport ConfigPanel from './studio/ConfigPanel.vue'\n\nexport default {\n  name: 'LowCodeEditor',\n  components: {\n    EditorHeader,\n    StudioComponentMenu,\n    PageCanvas,\n    ConfigPanel\n  },\n  data() {\n    return {\n      editorMode: 'edit',\n      componentTree: [],\n      activeComponentId: '',\n      historyStack: [],\n      historyIndex: -1,\n      maxHistory: 50\n    }\n  },\n  computed: {\n    activeComponent() {\n      if (!this.activeComponentId) return null\n      return this.$utils.findComponentById(this.componentTree, this.activeComponentId)\n    },\n    canUndo() {\n      return this.historyIndex > 0\n    },\n    canRedo() {\n      return this.historyIndex < this.historyStack.length - 1\n    }\n  },\n  created() {\n    this.pushHistory()\n  },\n  methods: {\n    handleModeChange(mode) {\n      this.editorMode = mode\n    },\n    handleComponentClick(item) {\n      this.activeComponentId = item.componentId\n    },\n    handleComponentDelete(componentId) {\n      this.$utils.removeComponentById(this.componentTree, componentId)\n      if (this.activeComponentId === componentId) {\n        this.activeComponentId = ''\n      }\n      this.pushHistory()\n    },\n    handleComponentUpdate(updated) {\n      this.$utils.updateComponentById(\n        this.componentTree,\n        updated.componentId,\n        updated\n      )\n      this.pushHistory()\n    },\n    handleCanvasChange(tree) {\n      this.componentTree = [...tree]\n      this.pushHistory()\n    },\n    handleClearCanvas() {\n      this.componentTree = []\n      this.activeComponentId = ''\n      this.pushHistory()\n    },\n    handleUndo() {\n      if (this.canUndo) {\n        this.historyIndex--\n        this.componentTree = this.$utils.deepClone(this.historyStack[this.historyIndex])\n      }\n    },\n    handleRedo() {\n      if (this.canRedo) {\n        this.historyIndex++\n        this.componentTree = this.$utils.deepClone(this.historyStack[this.historyIndex])\n      }\n    },\n    pushHistory() {\n      const snapshot = this.$utils.deepClone(this.componentTree)\n      \n      if (this.historyIndex < this.historyStack.length - 1) {\n        this.historyStack = this.historyStack.slice(0, this.historyIndex + 1)\n      }\n      \n      this.historyStack.push(snapshot)\n      \n      if (this.historyStack.length > this.maxHistory) {\n        this.historyStack.shift()\n      } else {\n        this.historyIndex++\n      }\n    },\n    handleSave() {\n      const json = JSON.stringify(this.componentTree, null, 2)\n      console.log('保存的JSON:', json)\n      \n      localStorage.setItem('low-code-cache', json)\n      \n      this.$Message.success({\n        content: '保存成功！JSON 已输出到控制台',\n        duration: 3\n      })\n    },\n    getCanvasJson() {\n      return this.$utils.deepClone(this.componentTree)\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.low-code-editor {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  \n  .editor-body {\n    flex: 1;\n    display: flex;\n    overflow: hidden;\n    \n    .left-panel {\n      width: 280px;\n      border-right: 1px solid #e8e8e8;\n      overflow: hidden;\n    }\n    \n    .center-panel {\n      flex: 1;\n      overflow: hidden;\n    }\n    \n    .right-panel {\n      width: 320px;\n      border-left: 1px solid #e8e8e8;\n      overflow: hidden;\n    }\n  }\n}\n</style>\n"],"mappings":";;AAwCA,OAAAA,YAAA;AACA,OAAAC,mBAAA;AACA,OAAAC,UAAA;AACA,OAAAC,WAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAL,YAAA;IACAC,mBAAA;IACAC,UAAA;IACAC;EACA;EACAG,KAAA;IACA;MACAC,UAAA;MACAC,aAAA;MACAC,iBAAA;MACAC,YAAA;MACAC,YAAA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACAC,gBAAA;MACA,UAAAL,iBAAA;MACA,YAAAM,MAAA,CAAAC,iBAAA,MAAAR,aAAA,OAAAC,iBAAA;IACA;IACAQ,QAAA;MACA,YAAAN,YAAA;IACA;IACAO,QAAA;MACA,YAAAP,YAAA,QAAAD,YAAA,CAAAS,MAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACAC,iBAAAC,IAAA;MACA,KAAAjB,UAAA,GAAAiB,IAAA;IACA;IACAC,qBAAAC,IAAA;MACA,KAAAjB,iBAAA,GAAAiB,IAAA,CAAAC,WAAA;IACA;IACAC,sBAAAD,WAAA;MACA,KAAAZ,MAAA,CAAAc,mBAAA,MAAArB,aAAA,EAAAmB,WAAA;MACA,SAAAlB,iBAAA,KAAAkB,WAAA;QACA,KAAAlB,iBAAA;MACA;MACA,KAAAY,WAAA;IACA;IACAS,sBAAAC,OAAA;MACA,KAAAhB,MAAA,CAAAiB,mBAAA,CACA,KAAAxB,aAAA,EACAuB,OAAA,CAAAJ,WAAA,EACAI,OACA;MACA,KAAAV,WAAA;IACA;IACAY,mBAAAC,IAAA;MACA,KAAA1B,aAAA,OAAA0B,IAAA;MACA,KAAAb,WAAA;IACA;IACAc,kBAAA;MACA,KAAA3B,aAAA;MACA,KAAAC,iBAAA;MACA,KAAAY,WAAA;IACA;IACAe,WAAA;MACA,SAAAnB,OAAA;QACA,KAAAN,YAAA;QACA,KAAAH,aAAA,QAAAO,MAAA,CAAAsB,SAAA,MAAA3B,YAAA,MAAAC,YAAA;MACA;IACA;IACA2B,WAAA;MACA,SAAApB,OAAA;QACA,KAAAP,YAAA;QACA,KAAAH,aAAA,QAAAO,MAAA,CAAAsB,SAAA,MAAA3B,YAAA,MAAAC,YAAA;MACA;IACA;IACAU,YAAA;MACA,MAAAkB,QAAA,QAAAxB,MAAA,CAAAsB,SAAA,MAAA7B,aAAA;MAEA,SAAAG,YAAA,QAAAD,YAAA,CAAAS,MAAA;QACA,KAAAT,YAAA,QAAAA,YAAA,CAAA8B,KAAA,SAAA7B,YAAA;MACA;MAEA,KAAAD,YAAA,CAAA+B,IAAA,CAAAF,QAAA