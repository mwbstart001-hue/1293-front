{"ast":null,"code":"import { componentMap } from '@/components-ui';\nexport default {\n  name: 'RenderComponent',\n  props: {\n    config: {\n      type: Object,\n      required: true\n    }\n  },\n  computed: {\n    componentName() {\n      const mapping = componentMap[this.config.tag];\n      return mapping ? mapping.runtime : this.config.tag;\n    },\n    componentProps() {\n      const props = {\n        ...this.config.props\n      };\n      if (props.style) {\n        props.styleConfig = props.style;\n        delete props.style;\n      }\n      return props;\n    }\n  }\n};","map":{"version":3,"names":["componentMap","name","props","config","type","Object","required","computed","componentName","mapping","tag","runtime","componentProps","style","styleConfig"],"sources":["src/components/studio/RenderComponent.vue"],"sourcesContent":["<template>\n  <div class=\"render-component\">\n    <component :is=\"componentName\" v-bind=\"componentProps\">\n      <template v-if=\"config.componentType === 'container' && config.children\">\n        <RenderComponent\n          v-for=\"child in config.children\"\n          :key=\"child.componentId\"\n          :config=\"child\"\n        />\n      </template>\n    </component>\n  </div>\n</template>\n\n<script>\nimport { componentMap } from '@/components-ui'\n\nexport default {\n  name: 'RenderComponent',\n  props: {\n    config: {\n      type: Object,\n      required: true\n    }\n  },\n  computed: {\n    componentName() {\n      const mapping = componentMap[this.config.tag]\n      return mapping ? mapping.runtime : this.config.tag\n    },\n    componentProps() {\n      const props = { ...this.config.props }\n      if (props.style) {\n        props.styleConfig = props.style\n        delete props.style\n      }\n      return props\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.render-component {\n  margin-bottom: 8px;\n}\n</style>\n"],"mappings":"AAeA,SAAAA,YAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,MAAA;MACAC,IAAA,EAAAC,M