{"ast":null,"code":"export default {\n  name: 'DevUIText',\n  props: {\n    content: {\n      type: String,\n      default: '这是一段文本内容'\n    },\n    styleConfig: {\n      type: Object,\n      default: () => ({})\n    },\n    componentId: {\n      type: String,\n      default: ''\n    }\n  },\n  computed: {\n    mergedStyle() {\n      return {\n        fontSize: '14px',\n        color: '#515a6e',\n        ...this.styleConfig\n      };\n    }\n  },\n  methods: {\n    handleClick() {\n      this.$emit('component-click', this.componentId);\n    }\n  }\n};","map":{"version":3,"names":["name","props","content","type","String","default","styleConfig","Object","componentId","computed","mergedStyle","fontSize","color","methods","handleClick","$emit"],"sources":["src/components-ui/basic/DevUIText.vue"],"sourcesContent":["<template>\n  <span class=\"dev-ui-text\" :style=\"mergedStyle\" @click.stop=\"handleClick\">{{ content }}</span>\n</template>\n\n<script>\nexport default {\n  name: 'DevUIText',\n  props: {\n    content: {\n      type: String,\n      default: '这是一段文本内容'\n    },\n    styleConfig: {\n      type: Object,\n      default: () => ({})\n    },\n    componentId: {\n      type: String,\n      default: ''\n    }\n  },\n  computed: {\n    mergedStyle() {\n      return {\n        fontSize: '14px',\n        color: '#515a6e',\n        ...this.styleConfig\n      }\n    }\n  },\n  methods: {\n    handleClick() {\n      this.$emit('component-click', this.componentId)\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.dev-ui-text {\n  display: inline-block;\n  padding: 4px 8px;\n  transition: all 0.3s ease;\n  \n  &:hover {\n    outline: 2px solid #2d8cf0;\n    outline-offset: 2px;\n    background: rgba(45, 140, 240, 0.05);\n  }\n}\n</style>\n"],"mappings":"AAKA;EACAA,IAAA;EACAC,KAAA;IACAC,OAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACAC,WAAA;MACAH,IAAA,EAAAI,MAAA;MACAF,OAAA,EAAAA,CAAA;IACA;IACAG,WAAA;MACAL,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;EACA;EACAI,QAAA;IACAC,YAAA;MACA;QACAC,QAAA;QACAC,KAAA;QACA,QAAAN;MACA;IACA;EACA;EACAO,OAAA;IACAC,YAAA;MACA,KAAAC,KAAA,yBAAAP,WAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}